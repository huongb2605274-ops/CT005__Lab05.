</body><!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8" />
			<meta name="viewport" content="width=device-width,initial-scale=1" />
			<title>Infographic & Video</title>
			<style>
				body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial; margin: 0; padding: 0; color: #222; background:#f8f9fb; }
				.wrap { max-width: 1000px; margin: 36px auto; padding: 20px; background: #fff; box-shadow: 0 6px 18px rgba(0,0,0,.06); border-radius: 8px; }
				header h1 { margin: 0 0 8px; font-size: 1.6rem; }
				.description { margin: 0 0 20px; color:#555; }
				.grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
				@media(min-width:800px){ .grid { grid-template-columns: 1fr 1fr; } }
				figure { margin: 0; }
				.infographic { width:100%; height:auto; display:block; border-radius:6px; box-shadow: 0 4px 12px rgba(0,0,0,.06); }
				figcaption { margin-top:8px; color:#666; font-size:.9rem; }
				.video-container { position: relative; width:100%; padding-top:56.25%; background:#000; border-radius:6px; overflow:hidden; }
				.video-container iframe { position:absolute; top:0; left:0; width:100%; height:100%; border:0; }
				footer { margin-top:18px; font-size:.85rem; color:#888; text-align:center; }
			</style>
		</head>
		<body>
			<main class="wrap">
				<header>
					<h1>Understanding Renewable Energy: Quick Overview</h1>
					<p class="description">A short infographic and a companion video that explain key renewable energy types, benefits, and trends.</p>
				</header>

				<section class="grid" aria-label="Infographic and video">
					<figure>
						<img src="infographic.jpg" alt="Infographic: renewable energy overview" class="infographic">
							<figcaption>Infographic: major renewable energy sources, pros & cons. (Replace with your image file)</figcaption>
						</figure>

					<div>
						<div class="video-container" aria-hidden="false">
							<!-- Replace the video ID below with the desired YouTube video ID -->
							<iframe src="https://www.youtube.com/embed/xwCaSBEUXls" title="YouTube video player"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
									allowfullscreen=""></iframe>
						</div>
						<p style="margin-top:10px; color:#555; font-size:.95rem;">
							Video: Short explainer on renewable energy technologies and deployment strategies.
						</p>
					</div>
				</section>

				<footer>
					&copy; 2026 Your Name or Organization. All rights reserved.
				</footer>
			</main>
		</body>
	</html>
</html>